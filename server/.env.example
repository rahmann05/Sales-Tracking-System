# ==============================================================================
# Sinar Anugrah Sales Tracking System - Server Environment Configuration
# ==============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client Origin (CORS Configuration)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection (Prisma)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=public
# Contoh: postgresql://postgres:password123@localhost:5432/sales_tracking_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sales_tracking_db?schema=public"

# Authentication & JWT Security Keys
JWT_SECRET="super-secret-access-token-key-change-this-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-this-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Attendance Validation Settings (Default GPS Geofence Radius in Meters)
ATTENDANCE_RADIUS_METERS=100

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Google Maps API Key for Server-Side Road Routing (Directions & Roads API)
GOOGLE_MAPS_API_KEY=your-google-maps-server-key
