PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sales_tracking_db?schema=public"

# Auth / JWT Settings
JWT_SECRET="super-secret-access-token-key"
JWT_REFRESH_SECRET="super-secret-refresh-token-key"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Attendance Validation Settings
ATTENDANCE_RADIUS_METERS=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Routing / Directions
# Jika key kosong / API gagal, backend otomatis fallback ke OSRM (router.project-osrm.org)
GOOGLE_MAPS_API_KEY=your-google-maps-server-key
# OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
