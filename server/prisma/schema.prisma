generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════════════════════

enum Role {
  SALES
  SUPERVISOR
  ADMIN
  KEPALA_GUDANG
  SUPIR
}

enum DeliveryStatus {
  DRAFT
  READY
  IN_TRANSIT
  COMPLETED
  PARTIAL
}

enum DeliveryStopStatus {
  PENDING
  DELIVERED
  REJECTED
  PARTIAL_REJECT
}

enum PjpStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum PjpType {
  SALES
}

enum WeekType {
  WEEK_1
  WEEK_2
  ALL
}

enum VisitStatus {
  PENDING
  VISITED
  CLOSED_REPORTED
  SKIPPED
}

enum RouteChangeType {
  REROUTE
  SKIP
  OFF_PJP_REQUEST
}

enum RouteChangeStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACKNOWLEDGED
}

enum UnlockStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AttendanceType {
  IN
  OUT
}

enum OutletLockStatus {
  NORMAL
  LOCKED
  UNLOCK_REQUESTED
}

enum OffPjpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutletValidationStatus {
  UNVALIDATED
  VALID
  LIKELY_VALID
  WARNING
  SUSPECT
  INCOMPLETE
}

// Trade Channel: digunakan bersama oleh Outlet dan CustomerRegistration
enum ChannelType {
  MODERN_TRADE
  GENERAL_TRADE
}

enum SubChannelType {
  // Modern Trade (MT)
  HYPERMARKET
  DRUGSTORE
  NAT_SUPERMARKET
  LOKAL_SUPERMARKET
  CHAIN_MINIMARKET
  LOKAL_MINIMARKET
  OTHER_MT

  // General Trade (GT)
  GROSIR
  SEMI_GROSIR
  TOKO_KELONTONG
  WARUNG
  TOKO_LISTRIK
  INSTITUSI
  TOKO_RETAIL
  OTHER_GT

  // Specialized / FMCG Channels
  PERKULAKAN
  KOPERASI
  BIDAN
  OUTLET_MOTORIS
  APOTIK
  BABY_SHOP
}

enum ChannelTier {
  TIER_1_TOP
  TIER_2_MIDDLE
  TIER_3_BOTTOM
  GOLD
  SILVER
  BRONZE
  BRONZE_A
  BRONZE_B
  BRONZE_C
}

enum PaymentType {
  CASH
  TOP
  TRANSFER
}

enum CashPaymentMethod {
  TUNAI
  GIRO
  CEK
}

enum VisitWeekType {
  WEEK_1_3
  WEEK_2_4
  ALL_WEEK
  WEEK_GANJIL
  WEEK_GENAP
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  SPV_APPROVED
  REGISTERED_ACTIVE
  REJECTED
}

// DivisiType enum dihapus — diganti dengan model Division yang dinamis (dikelola Admin)

enum OutletLocationType {
  DALAM_PASAR
  PINGGIR_JALAN
  DALAM_GANG
  KOMPLEK_PERUMAHAN
}

enum TaxType {
  PKP
  NON_PKP
}


enum OrderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ══════════════════════════════════════════════════════════════════════════════
// USER & CLUSTER MODELS
// ══════════════════════════════════════════════════════════════════════════════

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  role     Role

  // Cluster tempat user bertugas (primary cluster)
  clusterId String?
  cluster   Cluster? @relation("UserPrimaryCluster", fields: [clusterId], references: [id])

  // Clusters di mana user ini adalah sales yang ditugaskan (Cluster.assignedSalesId)
  assignedClusters   Cluster[] @relation("ClusterAssignedSales")
  supervisedClusters Cluster[] @relation("ClusterSupervisor")

  // Relasi operasional
  pjps                  Pjp[]
  pjpTemplates          PjpTemplate[]
  attendances           Attendance[]
  offPjpAttendances     OffPjpAttendance[]
  routeChangesReported  RouteChangeRequest[] @relation("RouteChangeReportedBy")
  routeChangesHandled   RouteChangeRequest[] @relation("RouteChangeHandledBy")
  routeChangesApproved  RouteChangeRequest[] @relation("RouteChangeApprovedBy")
  notifications         Notification[]
  unlockRequestsCreated OutletUnlockRequest[] @relation("UnlockRequestedBy")
  unlockRequestsHandled OutletUnlockRequest[] @relation("UnlockHandledBy")
  ordersCreated         Order[]              @relation("OrderCreatedBy")
  ordersApproved        Order[]              @relation("OrderApprovedBy")

  // CustomerRegistration FKs
  registrationsSubmitted CustomerRegistration[] @relation("RegistrationSalesman")
  registrationsApproved  CustomerRegistration[] @relation("RegistrationSpv")
  registrationsActivated CustomerRegistration[] @relation("RegistrationAdmin")

  // Delivery Management Relations (Kepala Gudang & Supir)
  packingListsCreated    PackingList[]          @relation("PackingListCreatedBy")
  deliveryRoutesAssigned DeliveryRoute[]        @relation("DeliveryRouteDriver")
  deliveryRoutesCreated  DeliveryRoute[]        @relation("DeliveryRouteCreatedBy")
  deliveryAttendances    DeliveryAttendance[]   @relation("DeliveryAttendanceDriver")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([clusterId])
}

model Cluster {
  id              String  @id @default(uuid())
  name            String
  region          String
  colorHex        String?
  centerLat       Float?
  centerLng       Float?
  outletCount     Int?    @default(0)

  // Sales penanggung jawab cluster
  assignedSalesId String?
  assignedSales   User?   @relation("ClusterAssignedSales", fields: [assignedSalesId], references: [id])

  // Supervisor yang membawahi cluster ini
  supervisorId String?
  supervisor   User?   @relation("ClusterSupervisor", fields: [supervisorId], references: [id])

  // Users yang primary clusternya adalah cluster ini
  users   User[]   @relation("UserPrimaryCluster")
  outlets Outlet[]
  routes  ClusterRoute[]

  // Registrasi outlet yang diarahkan ke cluster ini
  customerRegistrations CustomerRegistration[] @relation("RegistrationCluster")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([assignedSalesId])
}

model ClusterRoute {
  id              String  @id @default(uuid())
  clusterId       String
  cluster         Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  routeIndex      Int
  isActive        Boolean @default(false)
  totalDistanceKm Float
  outletOrder     Json
  overviewPath    Json?
  startOutletId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clusterId])
  @@index([clusterId, isActive])
}

// ══════════════════════════════════════════════════════════════════════════════
// OUTLET MODEL
// ══════════════════════════════════════════════════════════════════════════════

model Outlet {
  id        String @id @default(uuid())
  name      String
  address   String
  latitude  Float
  longitude Float

  // Relasi ke Cluster (FK mandatory)
  clusterId String
  cluster   Cluster @relation(fields: [clusterId], references: [id])

  outletCode    String? @unique
  ownerName     String?
  phone         String?
  outstanding   Float?  @default(0)
  radiusMeters  Int?    @default(50)
  itineraryCode String?

  // Trade Channel & SubChannel — synchronized with CustomerRegistration
  channel    ChannelType    @default(GENERAL_TRADE)
  type       ChannelType    @default(GENERAL_TRADE)
  subChannel SubChannelType @default(TOKO_RETAIL)

  lockStatus       OutletLockStatus       @default(NORMAL)
  validationStatus OutletValidationStatus @default(UNVALIDATED)

  // Geolokasi & Validasi
  validationConfidence Float?
  validatedAt          DateTime?
  validationDetails    Json?
  googleSuggestedLat   Float?
  googleSuggestedLng   Float?

  // Relasi operasional
  pjpStops                PjpStop[]
  pjpTemplateStops        PjpTemplateStop[]
  offPjpAttendances       OffPjpAttendance[]
  routeChangesReplacement RouteChangeRequest[] @relation("ReplacementOutlet")
  unlockRequests          OutletUnlockRequest[]

  // Delivery Management Relations
  packingLists   PackingList[]
  invoices       Invoice[]
  deliveryStops  DeliveryStop[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clusterId])
  @@index([channel])
  @@index([type])
  @@index([deletedAt])
  @@index([validationStatus])
}

// ══════════════════════════════════════════════════════════════════════════════
// PJP (PLAN JOURNEY PLAN) MODELS
// ══════════════════════════════════════════════════════════════════════════════

model Pjp {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        DateTime
  status      PjpStatus @default(SCHEDULED)
  type        PjpType
  sourcePjpId String?
  sourcePjp   Pjp?      @relation("PjpSourceHistory", fields: [sourcePjpId], references: [id])
  derivedPjps Pjp[]     @relation("PjpSourceHistory")
  stops       PjpStop[]
  routeChanges RouteChangeRequest[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@index([status])
}

model PjpStop {
  id       String      @id @default(uuid())
  pjpId    String
  pjp      Pjp         @relation(fields: [pjpId], references: [id], onDelete: Cascade)
  outletId String
  outlet   Outlet      @relation(fields: [outletId], references: [id])
  sequence Int
  status   VisitStatus @default(PENDING)

  attendances  Attendance[]
  routeChanges RouteChangeRequest[]
  orders       Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pjpId])
  @@index([outletId])
  @@index([pjpId, status])
}

model Attendance {
  id              String         @id @default(uuid())
  pjpStopId       String
  pjpStop         PjpStop        @relation(fields: [pjpStopId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  type            AttendanceType
  latitude        Float
  longitude       Float
  photoUrl        String?        @db.Text
  notes           String?
  durationMinutes Float?
  deviationMeters Float?
  distanceWarning String?        @default("OK")
  reason          String?
  earlyReason     String?
  orderAmount     Float?         @default(0)
  skuSold         Int?           @default(0)
  isEffectiveCall Boolean?       @default(false)
  timestamp       DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([pjpStopId])
  @@index([userId])
  @@index([timestamp])
  @@index([userId, timestamp])
}

model OffPjpAttendance {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  outletId     String?
  outlet       Outlet?      @relation(fields: [outletId], references: [id])
  outletName   String
  customerName String?
  phone        String?
  address      String
  latitude     Float
  longitude    Float
  photoUrl     String?
  reason       String
  status       OffPjpStatus @default(PENDING)
  validatedBy  String?
  validatedAt  DateTime?
  rejectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([outletId])
}

model OutletUnlockRequest {
  id              String       @id @default(uuid())
  outletId        String
  outlet          Outlet       @relation(fields: [outletId], references: [id])
  requestedBy     String
  requestedByUser User         @relation("UnlockRequestedBy", fields: [requestedBy], references: [id])
  reason          String
  status          UnlockStatus @default(PENDING_APPROVAL)
  handledBy       String?
  handledByUser   User?        @relation("UnlockHandledBy", fields: [handledBy], references: [id])
  handledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@index([status])
}

model RouteChangeRequest {
  id                  String            @id @default(uuid())
  pjpId               String
  pjp                 Pjp               @relation(fields: [pjpId], references: [id])
  pjpStopId           String
  pjpStop             PjpStop           @relation(fields: [pjpStopId], references: [id])
  type                RouteChangeType
  reportedBy          String
  reportedByUser      User              @relation("RouteChangeReportedBy", fields: [reportedBy], references: [id])
  handledBy           String?
  handledByUser       User?             @relation("RouteChangeHandledBy", fields: [handledBy], references: [id])
  replacementOutletId String?
  replacementOutlet   Outlet?           @relation("ReplacementOutlet", fields: [replacementOutletId], references: [id])
  reason              String?
  photoUrl            String?
  status              RouteChangeStatus
  approvedBy          String?
  approvedByUser      User?             @relation("RouteChangeApprovedBy", fields: [approvedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pjpId])
  @@index([pjpStopId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  payload   Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId])
}

model PjpTemplate {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  dayOfWeek Int
  weekType  WeekType
  stops     PjpTemplateStop[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, dayOfWeek, weekType])
  @@index([userId])
}

model PjpTemplateStop {
  id            String      @id @default(uuid())
  pjpTemplateId String
  pjpTemplate   PjpTemplate @relation(fields: [pjpTemplateId], references: [id], onDelete: Cascade)
  outletId      String
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  sequence      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pjpTemplateId])
  @@index([outletId])
}

model Vehicle {
  id                String    @id @default(uuid())
  code              String    @unique
  name              String
  maxCartons        Int
  maxWeightKg       Float
  fuelKmPerLiter    Float
  fuelType          String
  fuelPricePerLiter Float
  isActive          Boolean   @default(true)
  condition         VehicleCondition @default(AVAILABLE)
  totalKm                 Float    @default(0)
  lastOilChangeKm         Float    @default(0)
  lastOilFilterChangeKm   Float    @default(0)
  lastBrakePadChangeKm    Float    @default(0)
  
  deliveryRoutes    DeliveryRoute[]
  serviceRecords    VehicleServiceRecord[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

enum VehicleCondition {
  AVAILABLE
  IN_SERVICE
  BROKEN
}

model VehicleServiceRecord {
  id                String   @id @default(uuid())
  vehicleId         String
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id])
  serviceDate       DateTime
  workshopName      String
  serviceType       String
  cost              Float
  odometerAtService Int
  notes             String?  @db.Text
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ══════════════════════════════════════════════════════════════════════════════
// CUSTOMER REGISTRATION (NOO)
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
// DIVISION MODEL (Dinamis, dikelola Admin)
// ══════════════════════════════════════════════════════════════════════════════

model Division {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerRegistrations CustomerRegistration[]
}

model CustomerRegistration {
  id           String  @id @default(uuid())
  customerCode String? @unique

  // Divisi — relasi dinamis ke model Division
  divisionId   String?
  divisionRef  Division? @relation(fields: [divisionId], references: [id])
  // Tetap simpan nama divisi sebagai snapshot untuk historical display
  divisionName String?   @default("BELFOODS")

  branch     String  @default("PADALARANG")
  companyId  String?
  branchId   String?

  // 1. Data Identitas Outlet
  name            String
  ownerName       String?
  address         String
  address2        String?
  address3        String?
  phone           String?
  locationType    OutletLocationType @default(PINGGIR_JALAN)
  mappingLocation String?

  // 2. Data Pajak & Legalitas
  taxType        TaxType @default(NON_PKP)
  taxNumber      String?
  taxName        String?
  taxAddress     String?
  taxDocumentUrl String?

  // 3. Wilayah & Geografis (bukan hardcoded enum, terhubung ke Cluster dan fleksibel)
  area             String  @default("")
  subAreaKecamatan String?
  kelurahan        String?
  city             String     @default("")
  latitude         Float?     @default(0)
  longitude        Float?     @default(0)
  placeId          String?
  placeDetails     Json?
  photoId          String?
  photoUrl         String?

  // 4. Trade Channel & Tiering (sama dengan Outlet)
  channel     ChannelType    @default(GENERAL_TRADE)
  subChannel  SubChannelType @default(TOKO_RETAIL)
  channelTier ChannelTier   @default(BRONZE_C)

  // 5. Syarat Pembayaran
  paymentType       PaymentType        @default(CASH)
  cashMethod        CashPaymentMethod? @default(TUNAI)
  termOfPaymentDays Int                @default(0)
  bankAccountInfo   String?

  // 6. Rencana Kunjungan
  visitWeekSchedule VisitWeekType @default(ALL_WEEK)
  visitDays         String?

  // 7. Workflow Approval & Tracking
  registrationStatus RegistrationStatus @default(SUBMITTED)
  outletKnownBy      String?
  rejectionNote      String?

  // Snapshot nama untuk historical log dan query
  salesmanName String?
  spvName      String?
  adminName    String?

  // Relasi Foreign Key
  salesmanId   String?
  salesman     User?     @relation("RegistrationSalesman", fields: [salesmanId], references: [id])

  spvId        String?
  spv          User?     @relation("RegistrationSpv", fields: [spvId], references: [id])
  spvApprovedAt DateTime?

  adminId           String?
  admin             User?     @relation("RegistrationAdmin", fields: [adminId], references: [id])
  adminRegisteredAt DateTime?

  clusterId String?
  cluster   Cluster?  @relation("RegistrationCluster", fields: [clusterId], references: [id])

  // 8. Atribut Master ERP/ND6
  marketSegmentId    String?
  customerGroupId    String?
  customerCategoryId String?
  storeStatusId      String?
  isActive           Boolean @default(true)
  isBumn             Boolean @default(false)
  isContraBill       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([salesmanId])
  @@index([spvId])
  @@index([adminId])
  @@index([clusterId])
  @@index([registrationStatus])
  @@index([registrationStatus, deletedAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// ORDERS & PRODUCTS
// ══════════════════════════════════════════════════════════════════════════════

model Product {
  id         String      @id @default(uuid())
  sku        String      @unique
  name       String
  price      Float
  stock      Int         @default(100)
  code       String?
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
}

model Order {
  id             String      @id @default(uuid())
  pjpStopId      String
  pjpStop        PjpStop     @relation(fields: [pjpStopId], references: [id], onDelete: Cascade)
  createdBy      String
  createdByUser  User        @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  approvedBy     String?
  approvedByUser User?       @relation("OrderApprovedBy", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  totalValue     Float
  paymentType    PaymentType @default(CASH)
  status         OrderStatus @default(PENDING_APPROVAL)
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([pjpStopId])
  @@index([status])
  @@index([createdBy])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  subtotal  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

// ══════════════════════════════════════════════════════════════════════════════
// DELIVERY MANAGEMENT (Kepala Gudang & Supir)
// ══════════════════════════════════════════════════════════════════════════════

model PackingList {
  id            String   @id @default(uuid())
  code          String   @unique
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  totalCartons  Int      @default(0)
  totalWeight   Float?
  notes         String?
  invoices      Invoice[]
  deliveryStops DeliveryStop[]
  createdById   String
  createdBy     User     @relation("PackingListCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([outletId])
  @@index([createdById])
  @@index([createdAt])
}

model Invoice {
  id            String      @id @default(uuid())
  invoiceNumber String      @unique
  packingListId String
  packingList   PackingList @relation(fields: [packingListId], references: [id], onDelete: Cascade)
  outletId      String
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  totalAmount   Float?
  totalCartons  Int         @default(1)
  notes         String?
  isDelivered   Boolean     @default(false)
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([packingListId])
  @@index([outletId])
  @@index([invoiceNumber])
}

model DeliveryRoute {
  id           String         @id @default(uuid())
  code         String         @unique
  date         DateTime
  vehicleId    String
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id])
  driverId     String
  driver       User           @relation("DeliveryRouteDriver", fields: [driverId], references: [id])
  status       DeliveryStatus @default(DRAFT)
  totalCartons Int            @default(0)
  totalWeight  Float?
  notes        String?
  totalDistanceKm    Float?
  fuelConsumedLiters Float?
  stops        DeliveryStop[]
  createdById  String
  createdBy    User           @relation("DeliveryRouteCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([date])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([driverId, date])
  @@index([createdById])
}

model DeliveryStop {
  id              String             @id @default(uuid())
  deliveryRouteId String
  deliveryRoute   DeliveryRoute      @relation(fields: [deliveryRouteId], references: [id], onDelete: Cascade)
  packingListId   String
  packingList     PackingList        @relation(fields: [packingListId], references: [id])
  outletId        String
  outlet          Outlet             @relation(fields: [outletId], references: [id])
  sequence        Int
  status          DeliveryStopStatus @default(PENDING)
  arrivedAt       DateTime?
  completedAt     DateTime?
  latitude        Float?
  longitude       Float?
  photoUrl        String?            @db.Text
  rejectReason    String?
  rejectedCartons Int?               @default(0)
  notes           String?
  attendances     DeliveryAttendance[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([deliveryRouteId])
  @@index([packingListId])
  @@index([outletId])
  @@index([status])
}

model DeliveryAttendance {
  id             String         @id @default(uuid())
  deliveryStopId String
  deliveryStop   DeliveryStop   @relation(fields: [deliveryStopId], references: [id], onDelete: Cascade)
  driverId       String
  driver         User           @relation("DeliveryAttendanceDriver", fields: [driverId], references: [id])
  type           AttendanceType
  latitude       Float
  longitude      Float
  photoUrl       String?        @db.Text
  notes          String?
  timestamp      DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([deliveryStopId])
  @@index([driverId])
  @@index([timestamp])
}
