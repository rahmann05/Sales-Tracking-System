generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES
  SUPERVISOR
  ADMIN
  MANAJER_OPERASIONAL
}

enum PjpStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum PjpType {
  SALES
}

enum WeekType {
  WEEK_1
  WEEK_2
  ALL
}

enum VisitStatus {
  PENDING
  VISITED
  CLOSED_REPORTED
  SKIPPED
}

enum OrderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RouteChangeType {
  REROUTE
  SKIP
  OFF_PJP_REQUEST
}

enum RouteChangeStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACKNOWLEDGED
}

enum AttendanceType {
  IN
  OUT
}

enum OutletLockStatus {
  NORMAL
  LOCKED
  UNLOCK_REQUESTED
}

enum OffPjpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutletValidationStatus {
  UNVALIDATED
  VALID
  LIKELY_VALID
  WARNING
  SUSPECT
  INCOMPLETE
}

model User {
  id                    String               @id @default(uuid())
  name                  String
  email                 String               @unique
  password              String
  role                  Role
  clusterId             String?
  cluster               Cluster?             @relation(fields: [clusterId], references: [id])

  assignedClusters      Cluster[]            @relation("ClusterAssignedSales")

  pjps                  Pjp[]
  pjpTemplates          PjpTemplate[]
  attendances           Attendance[]
  offPjpAttendances     OffPjpAttendance[]
  ordersCreated         Order[]              @relation("OrderCreatedBy")
  ordersApproved        Order[]              @relation("OrderApprovedBy")
  routeChangesReported  RouteChangeRequest[] @relation("RouteChangeReportedBy")
  routeChangesHandled   RouteChangeRequest[] @relation("RouteChangeHandledBy")
  routeChangesApproved  RouteChangeRequest[] @relation("RouteChangeApprovedBy")
  notifications         Notification[]
  unlockRequestsCreated OutletUnlockRequest[] @relation("UnlockRequestedBy")
  unlockRequestsHandled OutletUnlockRequest[] @relation("UnlockHandledBy")

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
}

model Cluster {
  id              String         @id @default(uuid())
  name            String
  region          String
  colorHex        String?
  centerLat       Float?
  centerLng       Float?
  outletCount     Int?
  assignedSalesId String?
  assignedSales   User?          @relation("ClusterAssignedSales", fields: [assignedSalesId], references: [id])
  users           User[]
  outlets         Outlet[]
  routes          ClusterRoute[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
}

model ClusterRoute {
  id              String   @id @default(uuid())
  clusterId       String
  cluster         Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  routeIndex      Int
  isActive        Boolean  @default(false)
  totalDistanceKm Float
  outletOrder     Json
  overviewPath    Json?
  startOutletId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OutletType {
  GENERAL_TRADE
  MODERN_TRADE
}

model Outlet {
  id                       String                @id @default(uuid())
  name                     String
  address                  String
  latitude                 Float
  longitude                Float
  clusterId                String
  cluster                  Cluster               @relation(fields: [clusterId], references: [id])

  outletCode               String?               @unique
  ownerName                String?
  phone                    String?
  outstanding              Float?                @default(0)
  radiusMeters             Int?                  @default(50)
  type                     OutletType            @default(MODERN_TRADE)

  lockStatus               OutletLockStatus      @default(NORMAL)

  // ─── Validation Fields ────────────────────────────────────────────────────────
  validationStatus         OutletValidationStatus @default(UNVALIDATED)
  validationConfidence     Float?
  validatedAt              DateTime?
  validationDetails        Json?
  googleSuggestedLat       Float?
  googleSuggestedLng       Float?

  pjpStops                 PjpStop[]
  pjpTemplateStops         PjpTemplateStop[]
  offPjpAttendances        OffPjpAttendance[]
  routeChangesReplacement  RouteChangeRequest[]  @relation("ReplacementOutlet")
  unlockRequests           OutletUnlockRequest[]

  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  deletedAt                DateTime?
}

model Product {
  id          String      @id @default(uuid())
  sku         String      @unique
  name        String
  price       Float
  category    String?
  stock       Int?        @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
}

model Pjp {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  date          DateTime
  status        PjpStatus            @default(SCHEDULED)
  type          PjpType
  sourcePjpId   String?
  sourcePjp     Pjp?                 @relation("PjpSourceHistory", fields: [sourcePjpId], references: [id])
  derivedPjps   Pjp[]                @relation("PjpSourceHistory")
  stops         PjpStop[]
  routeChanges  RouteChangeRequest[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model PjpStop {
  id           String               @id @default(uuid())
  pjpId        String
  pjp          Pjp                  @relation(fields: [pjpId], references: [id], onDelete: Cascade)
  outletId     String
  outlet       Outlet               @relation(fields: [outletId], references: [id])
  sequence     Int
  status       VisitStatus          @default(PENDING)
  attendances  Attendance[]
  orders       Order[]
  routeChanges RouteChangeRequest[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Attendance {
  id        String         @id @default(uuid())
  pjpStopId String
  pjpStop   PjpStop        @relation(fields: [pjpStopId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  type      AttendanceType
  latitude  Float
  longitude Float
  photoUrl  String?
  timestamp DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model OffPjpAttendance {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])

  outletId        String?
  outlet          Outlet?      @relation(fields: [outletId], references: [id])

  outletName      String
  customerName    String?
  phone           String?
  address         String

  latitude        Float
  longitude       Float
  photoUrl        String?
  reason          String

  status          OffPjpStatus @default(PENDING)
  validatedBy     String?
  validatedAt     DateTime?
  rejectionNote   String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OutletUnlockRequest {
  id          String           @id @default(uuid())
  outletId    String
  outlet      Outlet           @relation(fields: [outletId], references: [id])
  requestedBy String
  requestedByUser User         @relation("UnlockRequestedBy", fields: [requestedBy], references: [id])
  reason      String
  status      RouteChangeStatus @default(PENDING_APPROVAL)
  handledBy   String?
  handledByUser User?          @relation("UnlockHandledBy", fields: [handledBy], references: [id])
  handledAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Order {
  id             String      @id @default(uuid())
  pjpStopId      String
  pjpStop        PjpStop     @relation(fields: [pjpStopId], references: [id])
  createdBy      String
  createdByUser  User        @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  items          OrderItem[]
  totalValue     Float
  paymentType    String?
  status         OrderStatus @default(PENDING_APPROVAL)
  approvedBy     String?
  approvedByUser User?       @relation("OrderApprovedBy", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  subtotal  Float
}

model RouteChangeRequest {
  id                  String            @id @default(uuid())
  pjpId               String
  pjp                 Pjp               @relation(fields: [pjpId], references: [id])
  pjpStopId           String
  pjpStop             PjpStop           @relation(fields: [pjpStopId], references: [id])
  type                RouteChangeType
  reportedBy          String
  reportedByUser      User              @relation("RouteChangeReportedBy", fields: [reportedBy], references: [id])
  handledBy           String?
  handledByUser       User?             @relation("RouteChangeHandledBy", fields: [handledBy], references: [id])
  replacementOutletId String?
  replacementOutlet   Outlet?           @relation("ReplacementOutlet", fields: [replacementOutletId], references: [id])
  reason              String?
  photoUrl            String?
  status              RouteChangeStatus
  approvedBy          String?
  approvedByUser      User?             @relation("RouteChangeApprovedBy", fields: [approvedBy], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  payload   Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PjpTemplate {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  dayOfWeek Int
  weekType  WeekType
  stops     PjpTemplateStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PjpTemplateStop {
  id            String      @id @default(uuid())
  pjpTemplateId String
  pjpTemplate   PjpTemplate @relation(fields: [pjpTemplateId], references: [id])
  outletId      String
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  sequence      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Vehicle {
  id                String    @id @default(uuid())
  code              String    @unique
  name              String
  maxCartons        Int
  maxWeightKg       Float
  fuelKmPerLiter    Float
  fuelType          String
  fuelPricePerLiter Float
  isActive          Boolean   @default(true)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

