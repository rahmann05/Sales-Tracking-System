generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES
  SUPERVISOR
  ADMIN
  MANAJER_OPERASIONAL
}

enum PjpStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum PjpType {
  SALES
}

enum WeekType {
  WEEK_1
  WEEK_2
  ALL
}

enum VisitStatus {
  PENDING
  VISITED
  CLOSED_REPORTED
  SKIPPED
}

enum OrderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RouteChangeType {
  REROUTE
  SKIP
  OFF_PJP_REQUEST
}

enum RouteChangeStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACKNOWLEDGED
}

enum AttendanceType {
  IN
  OUT
}

enum OutletLockStatus {
  NORMAL
  LOCKED
  UNLOCK_REQUESTED
}

enum OffPjpStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OutletValidationStatus {
  UNVALIDATED
  VALID
  LIKELY_VALID
  WARNING
  SUSPECT
  INCOMPLETE
}

model User {
  id                    String               @id @default(uuid())
  name                  String
  email                 String               @unique
  password              String
  role                  Role
  clusterId             String?
  cluster               Cluster?             @relation(fields: [clusterId], references: [id])

  assignedClusters      Cluster[]            @relation("ClusterAssignedSales")

  pjps                  Pjp[]
  pjpTemplates          PjpTemplate[]
  attendances           Attendance[]
  offPjpAttendances     OffPjpAttendance[]
  ordersCreated         Order[]              @relation("OrderCreatedBy")
  ordersApproved        Order[]              @relation("OrderApprovedBy")
  routeChangesReported  RouteChangeRequest[] @relation("RouteChangeReportedBy")
  routeChangesHandled   RouteChangeRequest[] @relation("RouteChangeHandledBy")
  routeChangesApproved  RouteChangeRequest[] @relation("RouteChangeApprovedBy")
  notifications         Notification[]
  unlockRequestsCreated OutletUnlockRequest[] @relation("UnlockRequestedBy")
  unlockRequestsHandled OutletUnlockRequest[] @relation("UnlockHandledBy")

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
}

model Cluster {
  id              String         @id @default(uuid())
  name            String
  region          String
  colorHex        String?
  centerLat       Float?
  centerLng       Float?
  outletCount     Int?
  assignedSalesId String?
  assignedSales   User?          @relation("ClusterAssignedSales", fields: [assignedSalesId], references: [id])
  users           User[]
  outlets         Outlet[]
  routes          ClusterRoute[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
}

model ClusterRoute {
  id              String   @id @default(uuid())
  clusterId       String
  cluster         Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  routeIndex      Int
  isActive        Boolean  @default(false)
  totalDistanceKm Float
  outletOrder     Json
  overviewPath    Json?
  startOutletId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OutletType {
  GENERAL_TRADE
  MODERN_TRADE
}

model Outlet {
  id                       String                @id @default(uuid())
  name                     String
  address                  String
  latitude                 Float
  longitude                Float
  clusterId                String
  cluster                  Cluster               @relation(fields: [clusterId], references: [id])

  outletCode               String?               @unique
  ownerName                String?
  phone                    String?
  outstanding              Float?                @default(0)
  radiusMeters             Int?                  @default(50)
  type                     OutletType            @default(MODERN_TRADE)

  lockStatus               OutletLockStatus      @default(NORMAL)

  // ─── Validation Fields ────────────────────────────────────────────────────────
  validationStatus         OutletValidationStatus @default(UNVALIDATED)
  validationConfidence     Float?
  validatedAt              DateTime?
  validationDetails        Json?
  googleSuggestedLat       Float?
  googleSuggestedLng       Float?

  pjpStops                 PjpStop[]
  pjpTemplateStops         PjpTemplateStop[]
  offPjpAttendances        OffPjpAttendance[]
  routeChangesReplacement  RouteChangeRequest[]  @relation("ReplacementOutlet")
  unlockRequests           OutletUnlockRequest[]

  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  deletedAt                DateTime?
}

model Product {
  id          String      @id @default(uuid())
  sku         String      @unique
  name        String
  price       Float
  category    String?
  stock       Int?        @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
}

model Pjp {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  date          DateTime
  status        PjpStatus            @default(SCHEDULED)
  type          PjpType
  sourcePjpId   String?
  sourcePjp     Pjp?                 @relation("PjpSourceHistory", fields: [sourcePjpId], references: [id])
  derivedPjps   Pjp[]                @relation("PjpSourceHistory")
  stops         PjpStop[]
  routeChanges  RouteChangeRequest[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model PjpStop {
  id           String               @id @default(uuid())
  pjpId        String
  pjp          Pjp                  @relation(fields: [pjpId], references: [id], onDelete: Cascade)
  outletId     String
  outlet       Outlet               @relation(fields: [outletId], references: [id])
  sequence     Int
  status       VisitStatus          @default(PENDING)
  attendances  Attendance[]
  orders       Order[]
  routeChanges RouteChangeRequest[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Attendance {
  id        String         @id @default(uuid())
  pjpStopId String
  pjpStop   PjpStop        @relation(fields: [pjpStopId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  type      AttendanceType
  latitude  Float
  longitude Float
  photoUrl  String?
  timestamp DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model OffPjpAttendance {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])

  outletId        String?
  outlet          Outlet?      @relation(fields: [outletId], references: [id])

  outletName      String
  customerName    String?
  phone           String?
  address         String

  latitude        Float
  longitude       Float
  photoUrl        String?
  reason          String

  status          OffPjpStatus @default(PENDING)
  validatedBy     String?
  validatedAt     DateTime?
  rejectionNote   String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OutletUnlockRequest {
  id          String           @id @default(uuid())
  outletId    String
  outlet      Outlet           @relation(fields: [outletId], references: [id])
  requestedBy String
  requestedByUser User         @relation("UnlockRequestedBy", fields: [requestedBy], references: [id])
  reason      String
  status      RouteChangeStatus @default(PENDING_APPROVAL)
  handledBy   String?
  handledByUser User?          @relation("UnlockHandledBy", fields: [handledBy], references: [id])
  handledAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Order {
  id             String      @id @default(uuid())
  pjpStopId      String
  pjpStop        PjpStop     @relation(fields: [pjpStopId], references: [id])
  createdBy      String
  createdByUser  User        @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  items          OrderItem[]
  totalValue     Float
  paymentType    String?
  status         OrderStatus @default(PENDING_APPROVAL)
  approvedBy     String?
  approvedByUser User?       @relation("OrderApprovedBy", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  subtotal  Float
}

model RouteChangeRequest {
  id                  String            @id @default(uuid())
  pjpId               String
  pjp                 Pjp               @relation(fields: [pjpId], references: [id])
  pjpStopId           String
  pjpStop             PjpStop           @relation(fields: [pjpStopId], references: [id])
  type                RouteChangeType
  reportedBy          String
  reportedByUser      User              @relation("RouteChangeReportedBy", fields: [reportedBy], references: [id])
  handledBy           String?
  handledByUser       User?             @relation("RouteChangeHandledBy", fields: [handledBy], references: [id])
  replacementOutletId String?
  replacementOutlet   Outlet?           @relation("ReplacementOutlet", fields: [replacementOutletId], references: [id])
  reason              String?
  photoUrl            String?
  status              RouteChangeStatus
  approvedBy          String?
  approvedByUser      User?             @relation("RouteChangeApprovedBy", fields: [approvedBy], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  payload   Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PjpTemplate {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  dayOfWeek Int
  weekType  WeekType
  stops     PjpTemplateStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PjpTemplateStop {
  id            String      @id @default(uuid())
  pjpTemplateId String
  pjpTemplate   PjpTemplate @relation(fields: [pjpTemplateId], references: [id])
  outletId      String
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  sequence      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Vehicle {
  id                String    @id @default(uuid())
  code              String    @unique
  name              String
  maxCartons        Int
  maxWeightKg       Float
  fuelKmPerLiter    Float
  fuelType          String
  fuelPricePerLiter Float
  isActive          Boolean   @default(true)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ══════════════════════════════════════════════════════════════════════════════
// TABEL BARU: FORM REGISTRASI OUTLET & IMPORT CUSTOMER PVMI (3NF UNIFIED MODEL)
// ══════════════════════════════════════════════════════════════════════════════

enum DivisiType {
  UNICHARM
  BELFOODS
  GENERAL
}

enum OutletLocationType {
  DALAM_PASAR
  PINGGIR_JALAN
  DALAM_GANG
  KOMPLEK_PERUMAHAN
}

enum TaxType {
  PKP
  NON_PKP
}

enum AreaRegion {
  CIMAHI
  KAB_BANDUNG_BARAT
  KAB_BANDUNG
  KOTA_BANDUNG
}

enum ChannelType {
  MODERN_TRADE   // MT
  GENERAL_TRADE  // GT
}

enum SubChannelType {
  // Modern Trade (MT)
  HYPERMARKET
  DRUGSTORE
  NAT_SUPERMARKET
  LOKAL_SUPERMARKET
  CHAIN_MINIMARKET
  LOKAL_MINIMARKET
  PERKULAKAN

  // General Trade (GT)
  KOPERASI
  BIDAN
  OUTLET_MOTORIS
  APOTIK
  GROSIR
  TOKO_RETAIL
  BABY_SHOP
}

enum ChannelTier {
  BRONZE_A
  BRONZE_B
  BRONZE_C
  SILVER
  GOLD
}

enum PaymentType {
  CASH
  TOP
  TRANSFER
}

enum CashPaymentMethod {
  TUNAI
  GIRO
  CEK
}

enum RegistrationStatus {
  DRAFT               // Disimpan oleh salesman
  SUBMITTED           // Diajukan oleh salesman
  SPV_APPROVED        // Disetujui oleh SPV
  OPS_APPROVED        // Disetujui oleh Ops Manager
  REGISTERED_ACTIVE   // Di-input ke sistem & diberi Kode Outlet oleh Admin
  REJECTED            // Ditolak (disertai alasan)
}

enum VisitWeekType {
  WEEK_GANJIL  // Week 1
  WEEK_GENAP   // Week 2
  ALL_WEEK     // Setiap Minggu
}

model CustomerRegistration {
  id                    String              @id @default(uuid())
  customerCode          String?             @unique // Kode Outlet (diisi Admin / customerID di Excel, cth: PVC0001)
  
  // Organisasi & Divisi
  division              DivisiType          @default(UNICHARM)
  branch                String              @default("PADALARANG")
  companyId             String?             // NS6083030001545 dari ERP
  branchId              String?             // 1522743351512 dari ERP
  divisionId            String?             // 1675645496290 dari ERP

  // 1. Data Identitas Outlet
  name                  String              // Nama Outlet / customerName (cth: JEMY TK.)
  ownerName             String?             // Nama Pemilik
  address               String              // Alamat Outlet / customerAddress1
  address2              String?             // customerAddress2
  address3              String?             // customerAddress3
  phone                 String?             // No Telp / customerPhone
  locationType          OutletLocationType  @default(PINGGIR_JALAN) // Lokasi Toko
  mappingLocation       String?             // Catatan Mapping Lokasi / patokan fisik

  // 2. Data Pajak & Legalitas (3NF Atomik)
  taxType               TaxType             @default(NON_PKP) // PKP vs NON PKP
  taxNumber             String?             // No NPWP / NIK
  taxName               String?             // Nama Wajib Pajak / Nama KTP
  taxAddress            String?             // Alamat NPWP / Alamat KTP
  taxDocumentUrl        String?             // Foto Lampiran NPWP / KTP / SPPKP

  // 3. Wilayah & Geografis
  area                  AreaRegion          @default(CIMAHI) // Area
  subAreaKecamatan      String?             // Sub Area / Kecamatan (subareaID)
  kelurahan             String?             // Kelurahan / Desa
  city                  String              @default("CIMAHI") // customerCity
  latitude              Float?              @default(0) // customerLatitude
  longitude             Float?              @default(0) // customerLongitude
  placeId               String?             // Google Place ID (cth: ChIJN1t_tDeuEmsRUsoyG83frY4)
  placeDetails          Json?               // Full Google Places API data (name, address, rating, category, phone, hours, plusCode, photo, url)
  photoId               String?             // ID Khusus Foto Outlet (cth: PHOTO-20260824-8F9A1B)
  photoUrl              String?             // Path / URL file foto di storage bucket folder

  // 4. Channel, Sub Channel & Tiering
  channel               ChannelType         @default(GENERAL_TRADE) // MODERN_TRADE (MT) / GENERAL_TRADE (GT)
  subChannel            SubChannelType      @default(TOKO_RETAIL) // Sub Channel (Retail, Grosir, Apotik, dll)
  channelTier           ChannelTier         @default(BRONZE_C) // Bronze A, Bronze B, Bronze C

  // 5. Syarat Pembayaran (Payment & Term of Payment)
  paymentType           PaymentType         @default(CASH) // CASH, TOP, TRANSFER
  cashMethod            CashPaymentMethod?  @default(TUNAI) // TUNAI, GIRO, CEK
  termOfPaymentDays     Int                 @default(0) // 0 (Cash), 7, 14, 30 Hari
  bankAccountInfo       String?             // Info Rekening Bank

  // 6. Rencana Kunjungan (PJP Schedule)
  visitWeekSchedule     VisitWeekType       @default(ALL_WEEK) // Week Ganjil, Genap, All Week
  visitDays             String?             // Format hari: "SENIN,KAMIS" atau "SENIN"

  // 7. Workflow Approval & Tracking
  registrationStatus    RegistrationStatus  @default(REGISTERED_ACTIVE)
  outletKnownBy         String?             // Nama & Jabatan Mengetahui Outlet
  salesmanName          String?             // Nama Salesman yang mengajukan
  salesmanId            String?             // ID Salesman (User ID jika ada)
  spvName               String?             // Nama SPV yang menyetujui
  spvApprovedAt         DateTime?
  opsManagerName        String?             // Nama Ops Manager yang menyetujui
  opsApprovedAt         DateTime?
  adminName             String?             // Nama Admin yang menginput ke sistem
  adminRegisteredAt     DateTime?
  rejectionNote         String?             // Alasan penolakan (jika REJECTED)

  // 8. Atribut Tambahan Master Excel ERP/ND6
  marketSegmentId       String?             // marketSegmentID (cth: MS0000)
  customerGroupId       String?             // customerGroupID
  customerCategoryId    String?             // customerCategoryID
  storeStatusId         String?             // storestatusID (cth: SS0000)
  isActive              Boolean             @default(true) // customerStatus = 'A'
  isBumn                Boolean             @default(false) // customerIsBUMN = 'N'
  isContraBill          Boolean             @default(true) // isContraBill = 'Y'

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
}


